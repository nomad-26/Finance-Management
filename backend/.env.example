# ==============================================================================
# KKV GOLD FINANCE & RENTAL MANAGEMENT - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to backend/.env and customize as needed.

NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173

# ── Cross-Origin Resource Sharing (CORS) ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Primary Database Layer: Firebase Cloud Firestore ─────────────────────────
FIREBASE_PROJECT_ID=kkv-finance-4b3bf
FIREBASE_STORAGE_BUCKET=kkv-finance-4b3bf.firebasestorage.app
FIREBASE_API_KEY=AIzaSyCwSG5LIzQVRYZZOs076tMcApXNdjE7pK8
FIREBASE_AUTH_DOMAIN=kkv-finance-4b3bf.firebaseapp.com


# ── Authentication & Security (JWT & RBAC) ────────────────────────────────────
JWT_SECRET=your_super_strong_cryptographic_jwt_secret_at_least_64_chars_long
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m

# ── Master Admin Account ──────────────────────────────────────────────────────
ADMIN_NAME=KKV Master Admin
ADMIN_EMAIL=admin@kkvgoldfinance.com
ADMIN_PASSWORD=SetAStrongPassword123!

# ── Local File System Storage & Backup Directory ──────────────────────────────
LOCAL_STORAGE_PATH=./data

# ── Google Cloud & Google Drive Storage (Binary Images, Documents & PDFs) ──────
GOOGLE_CLOUD_PROJECT_ID=kkv-gold-507605
GOOGLE_SERVICE_ACCOUNT_EMAIL=kkv-finance@kkv-gold-507605.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="<PRIVATE_KEY>"
GOOGLE_DRIVE_ROOT_FOLDER_ID=1VfN7XIIeC63bfvkmz4lh8yR_V_b6wViK

